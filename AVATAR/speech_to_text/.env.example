# API Keys Configuration
# Bu dosyayÄ± .env olarak kopyalayÄ±n ve kendi API key'lerinizi ekleyin
# cp .env.example .env

# ElevenLabs API Key
# https://elevenlabs.io/app/settings/api-keys adresinden alabilirsiniz
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID
# https://elevenlabs.io/app/voices adresinden voice ID'nizi bulabilirsiniz
ELEVENLABS_VOICE_ID=your_voice_id_here

# ElevenLabs STT Model
ELEVENLABS_STT_MODEL=scribe_v1

# Deepgram API Key
# https://console.deepgram.com/signup adresinden API key alabilirsiniz
DEEPGRAM_API_KEY=your_deepgram_api_key_here
